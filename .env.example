# ─── Privy ────────────────────────────────────────────────────────────
# Get your app id and secret from https://dashboard.privy.io → Settings → API keys
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-only — never expose to client
PRIVY_APP_SECRET=

# ─── RPC endpoints ────────────────────────────────────────────────────
# Public endpoints work for development but rate-limit aggressively.
# For production, use a dedicated provider (Alchemy, Infura, QuickNode).
NEXT_PUBLIC_BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_KEY

# ─── Deployed contract addresses ──────────────────────────────────────
# Populated after running the Foundry deploy script. See
# contracts/deployments/<chainId>.json after deploy.
NEXT_PUBLIC_FACTORY_ADDRESS_BASE=
NEXT_PUBLIC_FACTORY_ADDRESS_BASE_SEPOLIA=

# ─── Escrow deployer ──────────────────────────────────────────────────
# Private key (with 0x prefix) of the wallet used to deploy escrow contracts.
# This wallet must hold a small amount of ETH for gas (0.01 ETH is plenty for
# testnet; fund accordingly on mainnet). Keep this server-only and out of
# version control. The wallet does NOT hold user funds — it only deploys.
DEPLOYER_PRIVATE_KEY=0x

# ─── Off-ramp (withdraw USDC to bank) ──────────────────────────────────
# Moving from Ramp Network to Fun (fun.xyz). Fun's checkout SDK
# (@funkit/connect) is in closed beta as of 2026-09 — request access from
# developers@fun.xyz before wiring this in. No env var yet; WithdrawButton.tsx
# shows "coming soon" until then.

# ─── Resend (transactional email) ──────────────────────────────────────
# Get your API key from resend.com → API Keys. RESEND_FROM_EMAIL must use a
# domain you've verified in Resend (Domains → Add Domain → add the DNS
# records they give you), e.g. "Counterparti <notifications@counterparti.com>".
# Not used for login — Privy's email login is a passcode Privy emails itself,
# there's no password/reset flow for this app to handle.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-only, bypasses RLS. Keep out of client bundles.
# Needed for: npm run seed, npm run deploy:escrows, profile server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Admin ────────────────────────────────────────────────────────────
# Comma-separated list of email addresses allowed to sign in at /admin and
# remove competitions/entries from public view. Must match the email on the
# admin's Counterparti (Privy) account. Leave blank to disable /admin entirely.
ADMIN_EMAILS=
